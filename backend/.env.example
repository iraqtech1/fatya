APP_NAME=Fatya
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:3001
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fatya
DB_USERNAME=fatya
DB_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
ADMIN_USER=masal
ADMIN_PASSWORD=
DEV_OTP=false
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Takeed server-side credentials. Never put these in VITE_* variables.
OTP_PROVIDER=webhook
REQUIRE_REGISTRATION_OTP=false
TAKEED_API_KEY=
TAKEED_APP_ID=
TAKEED_TARGET=fatyh
TAKEED_IDENTITY_SECRET=
RESERVATION_MINUTES=15
# Local/test CLI only. Keep false on every deployed environment.
ALLOW_PAYMENT_SIMULATION=false
